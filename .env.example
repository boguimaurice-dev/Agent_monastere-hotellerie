# ---------------------------------------------------------------------------
# Configuration — Hôtellerie & Accueil, Monastère Sainte-Marie de Bouaké
#
# Copiez ce fichier en ".env". Ne le partagez pas : il contient des secrets.
#
# Une variable définie ici l'emporte toujours sur la valeur saisie dans
# Paramètres (tableau de bord). C'est utile pour les jetons, que l'on peut
# ainsi garder hors de la base de données et hors des sauvegardes.
# ---------------------------------------------------------------------------

# --- Emplacement des données (base SQLite et journaux) ----------------------
# Par défaut : le dossier data/ à côté de run.py
# HOTELLERIE_DATA_DIR=/var/lib/hotellerie

# --- Serveur ----------------------------------------------------------------
PORT=8080

# --- L'agent ----------------------------------------------------------------
# 1 = l'agent répond automatiquement ; 0 = relais humain seul
# agent_actif=1
# agent_heures_debut=6
# agent_heures_fin=21

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# À renseigner après la création de l'application sur developers.facebook.com
# wa_token=
# wa_phone_number_id=
# wa_verify_token=  # jeton unique à choisir ; aucun jeton par défaut
# wa_app_secret=  # obligatoire pour accepter les messages entrants
# wa_api_version=v21.0

# Numéro qui reçoit les messages d'essai (format international sans +)
# wa_numero_test=

# Adresse publique HTTPS du tableau de bord (affichée dans l'écran WhatsApp)
# site_url=https://hotellerie.exemple.org

# --- Relais vers les frères --------------------------------------------------
# Adresses séparées par des virgules
# hoteliers_emails=
# hoteliers_whatsapp=+2250700000000,+2250700000001
# notifier_par_email=1
# notifier_par_whatsapp=1

# --- Courriel (SMTP) ----------------------------------------------------------
# smtp_hote=smtp.gmail.com
# smtp_port=587
# smtp_utilisateur=
# smtp_mot_de_passe=
# smtp_expediteur=
# smtp_tls=1
#
# Note : avec Gmail, il faut un « mot de passe d'application »,
# pas le mot de passe habituel du compte.

# Le module de langage expérimental n’est pas branché aux réponses.

# --- API JSON (/api/agent) -----------------------------------------------------
# Laisser vide ferme l'API. À renseigner pour brancher le site web ou n8n.
# HOTELLERIE_API_CLE=
# api_ouverte=0
